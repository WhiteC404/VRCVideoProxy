cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 8 ALPHABET abcdef0123456789 suffix)
set(fixture "${TEST_ROOT}/release script ${suffix}")
file(MAKE_DIRECTORY "${fixture}/tools" "${fixture}/src" "${fixture}/build/dist")
file(COPY "${SOURCE_ROOT}/tools/release.cmake" DESTINATION "${fixture}/tools")
file(COPY "${SOURCE_ROOT}/CMakeLists.txt" DESTINATION "${fixture}")
file(COPY "${SOURCE_ROOT}/src/resources.rc" "${SOURCE_ROOT}/src/app.manifest" DESTINATION "${fixture}/src")
set(package_name "VRCVideoProxy-${VERSION}-windows-x64.zip")
set(package "${fixture}/build/dist/${package_name}")
set(checksum "${fixture}/build/dist/SHA256SUMS.txt")
file(WRITE "${package}" "release package fixture")
set(record "${fixture}/gh-call.txt")
set(gh "${fixture}/GitHub CLI probe.exe")
configure_file("${GH_PROBE}" "${gh}" COPYONLY)
set(base "${CMAKE_COMMAND}" -E env "GITHUB_REF_NAME=v${VERSION}" "VRCVP_TEST_RECORD=${record}")
set(script "${fixture}/tools/release.cmake")
execute_process(COMMAND ${base} "${CMAKE_COMMAND}" -P "${script}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0" OR NOT EXISTS "${checksum}")
  message(FATAL_ERROR "Normal packaging did not create a checksum file.")
endif()
execute_process(COMMAND ${base} "${CMAKE_COMMAND}" -DPUBLISH=ON -DDRY_RUN=ON "-DGH_EXECUTABLE=${gh}" -P "${script}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0" OR EXISTS "${record}")
  message(FATAL_ERROR "Dry-run must validate without invoking GitHub CLI.")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env GITHUB_REF_NAME=v999.999.999
  "${CMAKE_COMMAND}" -DPUBLISH=ON "-DGH_EXECUTABLE=${gh}" -P "${script}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result STREQUAL "0" OR EXISTS "${record}")
  message(FATAL_ERROR "A mismatched tag must fail before calling GitHub CLI.")
endif()
execute_process(COMMAND ${base} "${CMAKE_COMMAND}" -DPUBLISH=ON "-DGH_EXECUTABLE=${gh}" -P "${script}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0" OR NOT EXISTS "${record}")
  message(FATAL_ERROR "Publish did not invoke GitHub CLI.")
endif()
file(READ "${record}" actual)
set(expected "release\ncreate\nv${VERSION}\n${package}\n${checksum}\n--draft\n--verify-tag\n--title\nVRC Video Proxy v${VERSION}\n--generate-notes")
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "GitHub CLI received incorrect arguments: ${actual}")
endif()
execute_process(COMMAND ${base} VRCVP_TEST_FAIL=1 "${CMAKE_COMMAND}" -DPUBLISH=ON
  "-DGH_EXECUTABLE=${gh}" -P "${script}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result STREQUAL "0")
  message(FATAL_ERROR "GitHub CLI failure must propagate to the release job.")
endif()
message(STATUS "Release script contract passed")
